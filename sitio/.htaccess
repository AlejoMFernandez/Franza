# Seguridad básica
Options -Indexes
ServerSignature Off

# Prevenir acceso directo a archivos sensibles
<FilesMatch "\.(sql|log|md|env|json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteger archivos de configuración
<FilesMatch "^(init\.php|autoload\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Habilitar compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# Cache de archivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# MIME type para WebP
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# Headers de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# -----------------------------------------------
# URLs Amigables
# -----------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Sin RewriteBase: funciona igual en el hosting (raíz) y en la compu (subcarpeta).

    # Siempre con www (franza.com.ar → www.franza.com.ar), como estaba antes.
    RewriteCond %{HTTP_HOST} ^franza\.com\.ar$ [NC]
    RewriteRule ^(.*)$ https://www.franza.com.ar/$1 [R=301,L]

    # Le avisa a PHP que las direcciones lindas están activas.
    RewriteRule ^ - [E=FZ_URLS:1]

    # Proteger carpetas internas
    RewriteRule ^(classes|bootstrap|includes|data|views|tools)/ - [F,L]

    # Si el archivo o directorio existe, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Direcciones lindas del sitio público
    RewriteRule ^obras/civiles/?$ index.php?seccion=obrasciviles [L,QSA]
    RewriteRule ^obras/industriales/?$ index.php?seccion=obrasindustriales [L,QSA]
    RewriteRule ^obra/([0-9]+)/?$ index.php?seccion=obra-ver&id=$1 [L,QSA]
    RewriteRule ^obra/([a-z0-9-]+)/?$ index.php?seccion=obra-ver&slug=$1 [L,QSA]

    # Direcciones viejas que pudieron quedar compartidas
    RewriteRule ^inicio/?$ index.php?seccion=inicio [L,QSA]
    RewriteRule ^obras-civiles/?$ index.php?seccion=obrasciviles [L,QSA]
    RewriteRule ^obras-industriales/?$ index.php?seccion=obrasindustriales [L,QSA]
    RewriteRule ^iniciar-sesion/?$ index.php?seccion=iniciar-sesion [L,QSA]

    # Cualquier otra página inexistente: 404 del sitio (las imágenes o archivos que faltan, 404 común)
    RewriteCond %{REQUEST_URI} !\.(webp|jpe?g|png|gif|svg|ico|css|js|mp4|webm|mov|m4v|txt|xml|json|map|woff2?)$ [NC]
    RewriteRule ^ index.php?seccion=404 [L,QSA]
</IfModule>
